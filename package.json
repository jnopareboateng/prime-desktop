{
  "name": "prime-desktop",
  "version": "0.1.0",
  "description": "Prime Desktop — a cross-platform desktop app for Prime Agent",
  "main": "out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prebuild": "node scripts/generate-agent-manifest.mjs",
    "start": "electron-vite preview",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "sandbox:probes": "node --experimental-strip-types scripts/sandbox/run-probes.mts",
    "sandbox:selfcheck": "node --experimental-strip-types scripts/sandbox/selfcheck.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run package:mac",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.71",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "prime-agent": "https://pub-728493de92a943e2a9b2d17b4719f318.r2.dev/releases/v0.7.2/prime-agent-0.7.2.tgz",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
